# ============================================================
# HoReCa Marketplace - P0 local prototype
# ============================================================
# This file documents configuration. All values here are SAFE,
# NON-SECRET placeholders. The prototype runs entirely in the
# browser on synthetic data and does not call any backend.
#
# DO NOT put real credentials, service-role keys, or production
# connection strings here or in any committed file.
# ------------------------------------------------------------

# --- Application ---
# Interface language default. Reversible demo assumption, not a business decision.
VITE_DEFAULT_LOCALE=ru
# Staleness threshold (hours) after which price/availability is shown as "needs confirmation".
# A product parameter / hypothesis, NOT a claimed market standard.
VITE_STALENESS_HOURS=24

# --- Optional local Supabase (NOT used by the default mock prototype) ---
# Leave blank to run on the in-browser mock repository.
# Only point these at a LOCAL or explicitly TEST Supabase if you build one.
# The service_role key must NEVER be exposed to the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
