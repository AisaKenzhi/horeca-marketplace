# ============================================================
# HoReCa Marketplace - P0 local prototype
# ============================================================
# This file documents configuration. All values here are SAFE,
# NON-SECRET placeholders. The default demo stays browser-only on
# synthetic data; /account uses Supabase only when configured below.
#
# DO NOT put secret/service-role keys or production credentials here
# or in any committed file. A publishable/anon key is browser-safe but
# must be constrained by explicit grants and RLS policies.
# ------------------------------------------------------------

# --- Application ---
# Interface language default. Reversible demo assumption, not a business decision.
VITE_DEFAULT_LOCALE=ru
# Staleness threshold (hours) after which price/availability is shown as "needs confirmation".
# A product parameter / hypothesis, NOT a claimed market standard.
VITE_STALENESS_HOURS=24

# --- Optional Supabase account workspace ---
# Leave blank to keep /account in configuration-only mode and use the demo.
# For development, point these at the LOCAL Supabase stack. Never point at a
# production project unless it is separately approved and configured.
# Prefer a publishable key; legacy anon is accepted as a fallback.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
