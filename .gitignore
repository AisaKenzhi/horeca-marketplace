# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
dist-ssr/
*.local
*.tsbuildinfo

# Defensive: never commit compiled duplicates of TypeScript sources.
# Sources live as .ts/.tsx and all tsconfigs set "noEmit": true; any emitted .js
# next to a source file (or next to a config/spec) is an accident.
src/**/*.js
tests/**/*.js
e2e/**/*.js
vite.config.js
vitest.config.js
playwright.config.js

# Test artifacts
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- Secrets: never commit real environment files ---
.env
.env.*
!.env.example

# Upstream principle: never allow the Supabase service role key anywhere in the repo,
# even accidentally. These names are blocked defensively.
*service_role*
*service-role*
*.pem
*.key
